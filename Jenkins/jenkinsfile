pipeline {
   agent any
   tools {
       maven 'maven3'
   }
   environment {
       APP_NAME = "Tailorspot-app"
       APP_ENV = "DEV"
   }
   stages {
       stage('Checkout Code') {
           steps {
               checkout scm
           }
       }
       stage('Build') {
           steps {
               sh 'mvn clean install'
           }
       }
       stage('Test') {
           steps {
               sh 'mvn test'
           }
       }
   }
   post {
       always {
           echo 'Pipeline execution completed.'
       }
       success {
           echo 'Pipeline executed successfully.'
       }
       failure {
           echo 'Pipeline execution failed.'
       }
   }
}