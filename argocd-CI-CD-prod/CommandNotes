6. Validate the chart before deploying
---------
From the GitOps repository root:
helm lint charts/dms \
  -f environments/production/values.yaml

helm template dms charts/dms \
  --namespace dms-production \
  -f environments/production/values.yaml \
  > /tmp/dms-rendered.yaml

kubectl apply --dry-run=client \
  -f /tmp/dms-rendered.yaml

7. Bootstrap Argo CD on Amazon EKS
----------
aws sts get-caller-identity

aws eks update-kubeconfig \
  --region us-east-1 \
  --name roboshop-dev

kubectl get nodes
-------
kubectl create namespace argocd

kubectl apply -n argocd \
  --server-side \
  --force-conflicts \
  -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml

kubectl rollout status deployment/argocd-server \
  -n argocd --timeout=300s

kubectl get pods -n argocd


