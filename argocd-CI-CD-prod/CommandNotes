8. Register the GitOps repository with Argo CD
------------------------
If the GitOps repository is public, Argo CD can read it without repository credentials. For a private repository, register a read-only deploy key or supported repository credential.


argocd login localhost:8080
argocd repo add \
  https://github.com/YOUR_ORG/ikano-dms-gitops.git



kubectl apply -f applications/production-project.yaml
kubectl apply -f applications/dms-production.yaml

kubectl get applications -n argocd
argocd app get dms-production

9. Production verification commands
---------------------------

# Argo CD status
argocd app get dms-production

# Kubernetes resources
kubectl get all -n dms-production

# Deployment health
kubectl rollout status deployment/dms-dms \
  -n dms-production --timeout=300s

# Pod details
kubectl get pods -n dms-production -o wide

# Service and ingress
kubectl get svc,ingress -n dms-production

# HPA and disruption budget
kubectl get hpa,pdb -n dms-production

# Logs
kubectl logs -n dms-production \
  deployment/dms-dms --tail=100

------------------

kubectl describe pods -n dms-production

kubectl get events -n dms-production \
  --sort-by=.metadata.creationTimestamp
kubectl describe deployment -n dms-production dms-dms


